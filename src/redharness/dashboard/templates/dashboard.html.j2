<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{{ project }} — leaderboard dashboard</title>
<style>
  :root {
    --bg: #fbfbfa;
    --panel: #ffffff;
    --ink: #1b1d21;
    --muted: #5f6672;
    --line: #e3e5e9;
    --accent: #2f5d8a;
    --bar-track: #eef0f3;
    --bar-fill: #3a6ea5;
    --focus: #1f6feb;
  }
  * { box-sizing: border-box; }
  body {
    font-family: -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    margin: 0; background: var(--bg); color: var(--ink); line-height: 1.45;
  }
  .wrap { max-width: 1100px; margin: 0 auto; padding: 2.5rem 1.5rem 4rem; }
  header { border-bottom: 1px solid var(--line); padding-bottom: 1.25rem; margin-bottom: 1.75rem; }
  h1 { font-size: 1.6rem; margin: 0 0 0.25rem; letter-spacing: -0.01em; }
  .subtitle { color: var(--muted); font-size: 0.95rem; margin: 0; }
  .summary { display: flex; flex-wrap: wrap; gap: 1rem; margin: 1.25rem 0 0; padding: 0; list-style: none; }
  .summary li {
    background: var(--panel); border: 1px solid var(--line); border-radius: 8px;
    padding: 0.6rem 1rem; min-width: 7rem;
  }
  .summary .n { font-size: 1.5rem; font-weight: 600; display: block; }
  .summary .lbl { color: var(--muted); font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.04em; }
  .controls { display: flex; flex-wrap: wrap; gap: 0.75rem; align-items: end; margin: 1.5rem 0; }
  .controls label { display: flex; flex-direction: column; font-size: 0.8rem; color: var(--muted); gap: 0.25rem; }
  .controls input, .controls select {
    font: inherit; padding: 0.4rem 0.55rem; border: 1px solid var(--line);
    border-radius: 6px; background: var(--panel); color: var(--ink); min-width: 11rem;
  }
  :focus-visible { outline: 2px solid var(--focus); outline-offset: 1px; }
  section.surface { margin: 2.5rem 0; }
  section.surface h2 { font-size: 1.2rem; margin: 0 0 0.25rem; text-transform: capitalize; }
  section.surface .surface-meta { color: var(--muted); font-size: 0.85rem; margin: 0 0 1rem; }
  table { border-collapse: collapse; width: 100%; background: var(--panel); border: 1px solid var(--line); border-radius: 8px; overflow: hidden; }
  caption { text-align: left; font-weight: 600; padding: 0.6rem 0.75rem; color: var(--muted); }
  th, td { padding: 0.5rem 0.75rem; text-align: left; border-bottom: 1px solid var(--line); font-size: 0.9rem; }
  thead th { background: #f4f5f7; position: sticky; top: 0; }
  thead th button {
    all: unset; cursor: pointer; font: inherit; font-weight: 600; width: 100%;
    display: flex; gap: 0.3rem; align-items: center;
  }
  thead th button:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }
  tbody tr:hover { background: #f8f9fb; }
  td.value { font-variant-numeric: tabular-nums; }
  .na { color: var(--muted); }
  .bar { display: flex; align-items: center; gap: 0.6rem; }
  .bar .track { background: var(--bar-track); border-radius: 4px; flex: 1; height: 0.65rem; min-width: 6rem; overflow: hidden; }
  .bar .fill { background: var(--bar-fill); height: 100%; display: block; }
  .bar .num { font-variant-numeric: tabular-nums; min-width: 3.2rem; text-align: right; color: var(--muted); }
  .empty, .warnings { background: var(--panel); border: 1px solid var(--line); border-radius: 8px; padding: 1.25rem 1.5rem; }
  .empty h2 { margin-top: 0; }
  .warnings { border-color: #e6c98a; background: #fdf7ea; margin-bottom: 1.5rem; }
  .warnings h2 { font-size: 1rem; margin: 0 0 0.5rem; }
  .warnings ul { margin: 0; padding-left: 1.2rem; }
  .warnings li { font-size: 0.85rem; color: #6b5a23; }
  footer { color: var(--muted); font-size: 0.8rem; margin-top: 3rem; border-top: 1px solid var(--line); padding-top: 1rem; }
  .visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
</style>
</head>
<body>
<div class="wrap">
  <header>
    <h1>{{ project }} leaderboard dashboard</h1>
    <p class="subtitle">
      Aggregated red-team results across the jailbreak, injection, and leakage
      surfaces. Every number carries its (dataset version, judge, metric) provenance.{% if generated_label %}
      Generated: {{ generated_label }}.{% endif %}
    </p>
    <ul class="summary" id="summary" aria-label="Dashboard summary counts"></ul>
  </header>

  <div id="warnings" hidden class="warnings" role="status">
    <h2>Skipped leaderboards</h2>
    <ul id="warnings-list"></ul>
  </div>

  <div class="controls" role="search">
    <label>
      Filter rows
      <input type="search" id="filter" placeholder="target, attack, metric…"
             aria-label="Filter rows by text" autocomplete="off" />
    </label>
    <label>
      Surface
      <select id="surface-filter" aria-label="Filter by attack surface">
        <option value="">All surfaces</option>
      </select>
    </label>
  </div>

  <div id="surfaces"></div>

  <div id="empty" hidden class="empty">
    <h2>No runs yet</h2>
    <p>No <code>leaderboard.json</code> files were found in the runs directory.
       Run <code>redharness run configs/smoke.yaml</code>, then regenerate the dashboard.</p>
  </div>

  <footer>
    Static dashboard &middot; opens offline from <code>file://</code> &middot; no external resources.
  </footer>
</div>

<script type="application/json" id="data">{{ data_json }}</script>
<script>
(function () {
  "use strict";
  var DATA = JSON.parse(document.getElementById("data").textContent);
  var ROWS = DATA.rows;
  var SURFACE_ORDER = DATA.surfaceOrder;

  var COLUMNS = [
    { key: "target", label: "Target" },
    { key: "attack", label: "Attack" },
    { key: "dataset", label: "Dataset" },
    { key: "judge", label: "Judge" },
    { key: "metric", label: "Metric" },
    { key: "value", label: "Value", numeric: true }
  ];

  function el(tag, attrs, text) {
    var node = document.createElement(tag);
    if (attrs) { Object.keys(attrs).forEach(function (k) { node.setAttribute(k, attrs[k]); }); }
    if (text != null) { node.textContent = text; }
    return node;
  }

  function fmtValue(v) { return v == null ? "—" : v.toFixed(4); }

  function renderSummary() {
    var s = DATA.summary;
    var ul = document.getElementById("summary");
    [["runs", "runs"], ["targets", "targets"], ["surfaces", "surfaces"], ["cells", "metric cells"]]
      .forEach(function (pair) {
        var li = el("li");
        li.appendChild(el("span", { class: "n" }, String(s[pair[0]])));
        li.appendChild(el("span", { class: "lbl" }, pair[1]));
        ul.appendChild(li);
      });
  }

  function renderWarnings() {
    if (!DATA.warnings.length) { return; }
    var box = document.getElementById("warnings");
    var list = document.getElementById("warnings-list");
    DATA.warnings.forEach(function (w) { list.appendChild(el("li", null, w)); });
    box.hidden = false;
  }

  function valueCell(row) {
    var td = el("td", { class: "value" });
    if (row.value == null) {
      td.appendChild(el("span", { class: "na", "aria-label": "not available" }, "—"));
      return td;
    }
    if (row.is_rate) {
      var clamped = Math.max(0, Math.min(1, row.value));
      var wrap = el("div", { class: "bar" });
      var track = el("div", {
        class: "track", role: "img",
        "aria-label": row.metric + " " + fmtValue(row.value)
      });
      track.appendChild(el("span", { class: "fill", style: "width:" + (clamped * 100).toFixed(2) + "%" }));
      wrap.appendChild(track);
      wrap.appendChild(el("span", { class: "num" }, fmtValue(row.value)));
      td.appendChild(wrap);
    } else {
      td.textContent = fmtValue(row.value);
    }
    return td;
  }

  function compare(a, b, key, numeric, dir) {
    var av = a[key], bv = b[key], cmp;
    if (numeric) {
      // N/A sorts last regardless of direction.
      if (av == null && bv == null) { cmp = 0; }
      else if (av == null) { return 1; }
      else if (bv == null) { return -1; }
      else { cmp = av - bv; }
    } else {
      cmp = String(av).localeCompare(String(bv));
    }
    return dir === "desc" ? -cmp : cmp;
  }

  var SORT = {}; // surface -> { key, dir }

  function buildTable(surface, rows) {
    var table = el("table");
    table.appendChild(el("caption", null,
      "Compare targets per (attack, metric). " + rows.length + " row" + (rows.length === 1 ? "" : "s") + "."));
    var thead = el("thead");
    var htr = el("tr");
    COLUMNS.forEach(function (col) {
      var th = el("th", { scope: "col" });
      var state = SORT[surface];
      var active = state && state.key === col.key;
      var ariaSort = active ? (state.dir === "desc" ? "descending" : "ascending") : "none";
      th.setAttribute("aria-sort", ariaSort);
      var btn = el("button", { type: "button" });
      btn.appendChild(el("span", null, col.label));
      btn.appendChild(el("span", { "aria-hidden": "true" }, active ? (state.dir === "desc" ? "▼" : "▲") : "⇅"));
      btn.addEventListener("click", function () {
        var prev = SORT[surface];
        var dir = prev && prev.key === col.key && prev.dir === "asc" ? "desc" : "asc";
        SORT[surface] = { key: col.key, dir: dir, numeric: col.numeric };
        render();
      });
      th.appendChild(btn);
      htr.appendChild(th);
    });
    thead.appendChild(htr);
    table.appendChild(thead);

    var sorted = rows.slice();
    var state = SORT[surface];
    if (state) {
      sorted.sort(function (a, b) { return compare(a, b, state.key, state.numeric, state.dir); });
    }

    var tbody = el("tbody");
    sorted.forEach(function (row) {
      var tr = el("tr");
      ["target", "attack", "dataset", "judge", "metric"].forEach(function (k) {
        tr.appendChild(el("td", null, row[k]));
      });
      tr.appendChild(valueCell(row));
      tbody.appendChild(tr);
    });
    table.appendChild(tbody);
    return table;
  }

  function activeSurfaces(rows) {
    var present = {};
    rows.forEach(function (r) { present[r.surface] = true; });
    var ordered = SURFACE_ORDER.filter(function (s) { return present[s]; });
    Object.keys(present).sort().forEach(function (s) {
      if (ordered.indexOf(s) === -1) { ordered.push(s); }
    });
    return ordered;
  }

  function populateSurfaceFilter() {
    var sel = document.getElementById("surface-filter");
    activeSurfaces(ROWS).forEach(function (s) {
      sel.appendChild(el("option", { value: s }, s));
    });
  }

  function filteredRows() {
    var q = document.getElementById("filter").value.trim().toLowerCase();
    var surface = document.getElementById("surface-filter").value;
    return ROWS.filter(function (row) {
      if (surface && row.surface !== surface) { return false; }
      if (!q) { return true; }
      return [row.target, row.attack, row.dataset, row.judge, row.metric]
        .some(function (f) { return String(f).toLowerCase().indexOf(q) !== -1; });
    });
  }

  function render() {
    var host = document.getElementById("surfaces");
    host.textContent = "";
    var rows = filteredRows();
    activeSurfaces(rows).forEach(function (surface) {
      var sRows = rows.filter(function (r) { return r.surface === surface; });
      if (!sRows.length) { return; }
      var section = el("section", { class: "surface" });
      section.appendChild(el("h2", null, surface));
      var targets = {}; sRows.forEach(function (r) { targets[r.target] = true; });
      section.appendChild(el("p", { class: "surface-meta" },
        Object.keys(targets).length + " target(s) across " + sRows.length + " metric cell(s)."));
      section.appendChild(buildTable(surface, sRows));
      host.appendChild(section);
    });
  }

  renderSummary();
  renderWarnings();
  if (!ROWS.length) {
    document.getElementById("empty").hidden = false;
    document.querySelector(".controls").hidden = true;
  } else {
    populateSurfaceFilter();
    document.getElementById("filter").addEventListener("input", render);
    document.getElementById("surface-filter").addEventListener("change", render);
    render();
  }
})();
</script>
</body>
</html>
